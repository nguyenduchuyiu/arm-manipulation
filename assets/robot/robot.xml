<!--
NexArm MuJoCo parameter audit for minimal-effort sim-to-real

LABELS
  [CAN FIX NOW]       Derive/repair from your existing STL, physical assembly or calibration.
  [ASK HIWONDER]      Prefer official manufacturer data; avoids unnecessary system ID.
  [MINIMAL SYSID]     Only coarse real-arm measurement if official data is unavailable.
  [CALIBRATE YOURSELF] Standard kinematic/camera/gripper calibration, not full dynamics ID.

PRIORITY REQUEST TO HIWONDER
  1. Official URDF or joint origins/axes/limits/zero conventions
  2. Per-link mass, center of mass and inertia tensor
  3. Servo model used on each joint
  4. Per-joint output torque limits
  5. Joint velocity and acceleration limits
  6. Gear ratios, if relevant/available
  7. Joint damping/friction and controller/PID/motion-profile parameters, if available

MINIMUM REAL-ROBOT WORK AFTER THAT
  - verify encoder zero/sign and FK on several poses
  - calibrate wrist/front cameras
  - calibrate gripper command -> jaw gap
  - run one short q_cmd -> q_measured trajectory for coarse delay/tracking validation
-->

<mujoco model="NexArm-sim">
  <compiler angle="radian" meshdir="meshes" autolimits="true" />
  <!-- [CAN FIX NOW]
       MuJoCo numerical settings. These are simulator design choices, not NexArm
       manufacturer parameters. Keep timestep/integrator based on stability and
       control-rate requirements. -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" />
  <default>
    <!-- [MINIMAL SYSID START]
         These are EFFECTIVE MuJoCo joint parameters, not values that can be
         recovered reliably from STL geometry.
         - damping / frictionloss: optionally ask Hiwonder if they have measured values,
           otherwise keep nominal values and randomize or do a very small tracking test.
         - armature: low-priority for position-controlled sim-to-real; keep nominal /
           randomize unless motor+gear reflected inertia is supplied.
         Do NOT treat the current numbers as official NexArm values. -->
    <default class="arm_joint">
      <joint damping="0.2" frictionloss="0.1" armature="0.005" />
    </default>
    <!-- [MINIMAL SYSID END] -->
    <default class="arm_actuator">
      <position kp="100.0" kv="2.0" />
    </default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" />
    </default>
    <!-- [CAN FIX NOW / OPTIONAL MINIMAL SYSID]
         Collision proxies are a simulation abstraction and can be built from the STL.
         Contact friction is environment/material dependent; do not expect a single
         "official robot friction" value. Use reasonable nominal values + randomization,
         or measure only if grasp/contact transfer is poor. -->
    <default class="collision">
      <geom contype="1" conaffinity="3" group="3" rgba="0 0 0 0" friction="1.1 0.01 0.001" />
    </default>
  </default>
  <!-- [CAN FIX NOW]
       Mesh geometry and mesh scale come from the STL files you already have.
